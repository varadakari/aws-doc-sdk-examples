using namespace Aws::Crt::Crypto;
using namespace Aws::Crt::Io;
using namespace Aws::S3Crt;
using namespace Aws::Auth;

// Helper to throw runtime_error with OpenSSL error details
static void ThrowOpenSSLError(const char* msg)
{
    unsigned long errCode = ERR_get_error();
    char errBuf[256];
    ERR_error_string_n(errCode, errBuf, sizeof(errBuf));
    throw std::runtime_error(std::string(msg) + ": " + errBuf);
}

